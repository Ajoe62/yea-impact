# Copy this file to `.env` and fill in your Supabase project values
# (Supabase dashboard → Project Settings → API).
PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLIC_KEY

# Optional. Origin used in event check-in QR codes and sign-up confirmation
# and password-reset links. Defaults to the address the site is served from. Set it in Vercel's
# Production environment so links always use the main domain.
# PUBLIC_SITE_URL=https://www.yeaimpactfoundation.top
