---
import MediaImage from './media/MediaImage.astro';
import type { ImageSlot } from '../lib/media';

/**
 * Banner at the top of every inner page, in the campaign-poster style: a navy
 * block with diagonal slashes on the right and a red band underneath. With
 * `media`, an image slot sits behind it under a navy wash.
 */
interface Props {
  media?: ImageSlot;
  alt?: string;
  eyebrow?: string;
  title: string;
  /** Optional second headline line, set in blush (the poster's two-tone title). */
  accent?: string;
  subtitle?: string;
  /** Smaller banner for detail pages (image variant only). */
  compact?: boolean;
}

const { media, alt = '', eyebrow, title, accent, subtitle, compact = false } = Astro.props;
---

<section class:list={['page-hero on-dark stripe-bottom', media ? (compact ? 'min-h-60' : 'min-h-80 md:min-h-[26rem]') : '']}>
  {
    media && (
      <>
        <div class="absolute inset-0 -z-20">
          <MediaImage media={media} alt={alt} priority tone="dark" align="end" />
        </div>
        <div class="page-hero-wash absolute inset-0 -z-10" aria-hidden="true" />
      </>
    )
  }
  <div class="page-hero-slash" aria-hidden="true"></div>

  <div class:list={['container-page relative', media && 'flex h-full flex-col justify-end']}>
    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow eyebrow-on-dark mb-4">{eyebrow}</p>}
      <h1 class:list={[compact ? 'text-4xl md:text-5xl' : 'text-5xl md:text-7xl']}>
        {title}
        {accent && <><br /><em>{accent}</em></>}
      </h1>
      {subtitle && <p class="page-hero-lead">{subtitle}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding: 4rem 0 3.5rem;
    color: #fff;
    background: var(--color-brand-700);
  }

  @media (min-width: 768px) {
    .page-hero {
      padding: 5rem 0 4.5rem;
    }
  }

  .page-hero-wash {
    background:
      linear-gradient(to right, rgb(28 32 92 / 0.94) 0%, rgb(28 32 92 / 0.78) 45%, rgb(28 32 92 / 0.3) 100%),
      linear-gradient(to top, rgb(17 20 58 / 0.55) 0%, rgb(17 20 58 / 0) 45%);
  }

  .page-hero-slash {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: -1;
    width: min(42vw, 30rem);
    pointer-events: none;
    background:
      linear-gradient(to top left, var(--color-accent-500) 0 50%, transparent calc(50% + 1px)) bottom right / 40% 70% no-repeat,
      linear-gradient(to top left, rgb(255 255 255 / 0.07) 0 50%, transparent calc(50% + 1px)) bottom right / 100% 100% no-repeat;
  }

  @media (max-width: 767px) {
    .page-hero-slash {
      opacity: 0.55;
    }
  }

  .page-hero-lead {
    max-width: 60ch;
    margin-top: 1.25rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.85);
  }
</style>
