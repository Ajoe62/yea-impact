---
/** Inline status message: form results, sign-in prompts and setup hints. */
interface Props {
  tone?: 'info' | 'success' | 'error';
  class?: string;
}

const { tone = 'info', class: className } = Astro.props;
const styles = {
  info: 'bg-brand-50 text-brand-900 ring-brand-700/15',
  success: 'bg-brand-100 text-brand-900 ring-brand-700/25',
  error: 'bg-accent-50 text-accent-700 ring-accent-500/25',
};
---

<div class:list={['rounded-xl px-4 py-3 text-sm ring-1', styles[tone], className]} role={tone === 'error' ? 'alert' : 'status'}>
  <slot />
</div>
