---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';

const year = new Date().getFullYear();
const groups = [
  {
    title: 'Get involved',
    links: [
      { href: '/programs', label: 'Programs' },
      { href: '/courses', label: 'Courses' },
      { href: '/mentorship', label: 'Mentorship' },
    ],
  },
  {
    title: 'Opportunities',
    links: [
      { href: '/events', label: 'Events' },
      { href: '/jobs', label: 'Jobs' },
      { href: '/login', label: 'Create an account' },
    ],
  },
];
---

<footer class="mt-auto bg-brand-950 text-white/70">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[2fr_1fr_1fr]">
    <div class="max-w-sm space-y-3">
      <div class="flex items-center gap-4">
        <Image src={logo} alt="" class="size-20 rounded-full" />
        <p class="font-display text-xl leading-tight font-bold text-white">Dynamic Youth Empowerment &amp; Advocacy</p>
      </div>
      <p class="text-sm leading-relaxed">
        Mindset reorientation, skills training, mentorship and industry connections for
        African youths aged 12 to 40.
      </p>
    </div>
    {
      groups.map((g) => (
        <div>
          <p class="mb-3 text-sm font-semibold text-white">{g.title}</p>
          <ul class="space-y-2 text-sm">
            {g.links.map((l) => (
              <li>
                <a href={l.href} class="hover:text-sun-300">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-white/10">
    <p class="container-page py-5 text-xs">© {year} Dynamic Youth Empowerment &amp; Advocacy. All rights reserved.</p>
  </div>
</footer>
