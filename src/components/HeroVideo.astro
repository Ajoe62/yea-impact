---
import { findVideoSequence } from '../lib/media';

/**
 * Full-screen hero with a background of looping, cross-fading videos.
 * Clips come from src/assets/videos/home-hero-1.mp4, home-hero-2.mp4 … (any
 * number). With no clips, or for visitors who ask for reduced motion, only the
 * gradient background shows. The slot holds the hero content.
 */
interface Props {
  /** Accessible description of the videos, used on the pause button. */
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
const clips = findVideoSequence('home-hero');
---

<section class:list={['hero', className]} data-hero>
  {
    clips.length > 0 && (
      <div class="hero-video-bg" aria-hidden="true">
        {clips.map((sources, i) => (
          <video
            class="hero-vid"
            muted
            playsinline
            autoplay={i === 0}
            preload={i === 0 ? 'auto' : 'none'}
            loop={clips.length === 1}
          >
            {sources.map((s) => (
              <source src={s.src} type={s.type} />
            ))}
          </video>
        ))}
      </div>
    )
  }
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="hero-content">
    <slot />
  </div>

  {
    clips.length > 0 && (
      <button
        type="button"
        class="hero-toggle flex size-10 items-center justify-center rounded-full bg-black/45 text-white backdrop-blur transition hover:bg-black/65 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        aria-label={`Pause background videos: ${label}`}
        data-hero-toggle
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-pause>
          <rect x="6" y="5" width="4" height="14" rx="1" />
          <rect x="14" y="5" width="4" height="14" rx="1" />
        </svg>
        <svg class="hidden size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-play>
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(
      ellipse 90% 80% at 70% 35%,
      var(--color-brand-800) 0%,
      var(--color-brand-950) 60%,
      #03140e 100%
    );
  }

  .hero-video-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    /* Matches GSAP's power2.inOut. */
    transition: opacity 1.5s cubic-bezier(0.45, 0, 0.55, 1);
  }

  /* Darkens the top edge and the left side so the headline stays legible. */
  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(7 39 28 / 0.8) 0%, rgb(7 39 28 / 0) 30%),
      linear-gradient(to right, rgb(7 39 28 / 0.85) 0%, rgb(7 39 28 / 0.35) 55%, rgb(7 39 28 / 0) 100%);
  }

  /* On phones the text spans the full width, so darken from the bottom too. */
  @media (max-width: 767px) {
    .hero-vignette {
      background:
        linear-gradient(to bottom, rgb(7 39 28 / 0.8) 0%, rgb(7 39 28 / 0) 30%),
        linear-gradient(to top, rgb(7 39 28 / 0.9) 0%, rgb(7 39 28 / 0.4) 60%, rgb(7 39 28 / 0) 100%);
    }
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-bg,
    .hero-toggle {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /** Wires up one hero and returns its teardown. */
  function setupHero(hero: HTMLElement): () => void {
    const videos = [...hero.querySelectorAll<HTMLVideoElement>('.hero-vid')];
    const toggle = hero.querySelector<HTMLButtonElement>('[data-hero-toggle]');
    if (videos.length === 0) return () => {};

    const controller = new AbortController();
    const { signal } = controller;
    let current = 0;
    let userPaused = false;

    const play = (video: HTMLVideoElement) => {
      // Autoplay can be refused (e.g. low-power mode); the gradient shows through.
      video.play().catch(() => {});
    };

    // Clips after the first start with preload="none", which load() alone won't
    // override, so switch them to "auto" first. Already-buffered clips are skipped.
    const buffer = (video: HTMLVideoElement) => {
      if (video.preload === 'auto') return;
      video.preload = 'auto';
      video.load();
    };

    const label = toggle?.getAttribute('aria-label')!.replace(/^(Pause|Play)/, '') ?? '';
    const sync = () => {
      if (!toggle) return;
      const paused = videos[current].paused;
      toggle.setAttribute('aria-label', `${paused ? 'Play' : 'Pause'}${label}`);
      toggle.querySelector('[data-icon-pause]')!.classList.toggle('hidden', paused);
      toggle.querySelector('[data-icon-play]')!.classList.toggle('hidden', !paused);
    };

    const advance = () => {
      const outgoing = videos[current];
      current = (current + 1) % videos.length;
      const incoming = videos[current];

      play(incoming);
      incoming.style.opacity = '1';
      outgoing.style.opacity = '0';

      const onFadedOut = (event: TransitionEvent) => {
        if (event.propertyName !== 'opacity') return;
        outgoing.removeEventListener('transitionend', onFadedOut);
        if (outgoing === videos[current]) return; // Came round again mid-fade.
        outgoing.pause();
        outgoing.currentTime = 0;
      };
      outgoing.addEventListener('transitionend', onFadedOut, { signal });

      buffer(videos[(current + 1) % videos.length]);
    };

    if (videos.length > 1) {
      videos.forEach((video) => {
        video.addEventListener('ended', () => video === videos[current] && advance(), { signal });
      });
    }

    videos.forEach((video) => {
      video.addEventListener('play', sync, { signal });
      video.addEventListener('pause', sync, { signal });
    });

    toggle?.addEventListener(
      'click',
      () => {
        const video = videos[current];
        userPaused = !video.paused;
        if (userPaused) video.pause();
        else play(video);
      },
      { signal },
    );

    reduceMotion.addEventListener(
      'change',
      () => {
        if (reduceMotion.matches) videos[current].pause();
        else if (!userPaused) play(videos[current]);
      },
      { signal },
    );

    videos[0].style.opacity = '1';
    if (videos.length > 1) buffer(videos[1]);
    if (reduceMotion.matches) videos[0].pause();
    else play(videos[0]);
    sync();

    return () => {
      controller.abort();
      videos.forEach((video) => video.pause());
    };
  }

  let teardowns: (() => void)[] = [];

  function teardown() {
    teardowns.forEach((fn) => fn());
    teardowns = [];
  }

  function init() {
    teardown();
    teardowns = [...document.querySelectorAll<HTMLElement>('[data-hero]')].map(setupHero);
  }

  init();
  // Page transitions (Astro view transitions) and the back/forward cache.
  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('astro:after-swap', init);
  window.addEventListener('pagehide', teardown);
  window.addEventListener('pageshow', (event) => event.persisted && init());
</script>
