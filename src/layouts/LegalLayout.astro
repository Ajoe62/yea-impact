---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

/** Shared frame for the privacy policy and terms: hero, "last updated" line and readable prose. */
interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageHero eyebrow="Legal" title={title} subtitle={`Last updated ${updated}`} />

  <section class="container-page py-14 lg:py-20">
    <article class="legal mx-auto max-w-3xl">
      <slot />
    </article>
  </section>
</BaseLayout>

<style>
  .legal :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--color-brand-800);
  }
  .legal :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-brand-800);
  }
  .legal :global(p),
  .legal :global(li) {
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-ink) 80%, transparent);
  }
  .legal :global(p) {
    margin: 0 0 1rem;
  }
  .legal :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal :global(li) {
    margin-bottom: 0.4rem;
  }
  .legal :global(a) {
    font-weight: 600;
    color: var(--color-brand-700);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal :global(strong) {
    color: var(--color-ink);
  }
</style>
