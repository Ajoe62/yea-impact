---
import { actions, isInputError } from 'astro:actions';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaImage from '../components/media/MediaImage.astro';
import Notice from '../components/Notice.astro';

// Reached from the reset (or invite) email: /auth/confirm signs the user in first.
const result = Astro.getActionResult(actions.updatePassword);
if (result?.data) return Astro.redirect('/login?password=updated');

const user = Astro.locals.user;
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : {};
const formError = result?.error && !isInputError(result.error) ? result.error.message : undefined;
---

<BaseLayout title="Choose a new password">
  <section class="container-page grid items-stretch gap-10 py-10 lg:grid-cols-2 lg:py-16">
    <div class="hidden overflow-hidden rounded-3xl lg:block">
      <div class="relative h-full min-h-[36rem]">
        <MediaImage media="login-side" alt="Young people at a YEA event" sizes="50vw" priority />
      </div>
    </div>

    <div class="flex items-center justify-center">
      <div class="w-full max-w-md space-y-8">
        <div class="space-y-2">
          <p class="eyebrow">Account help</p>
          <h1 class="text-5xl text-brand-700 md:text-6xl">Choose a new password</h1>
        </div>

        {
          user ? (
            <form method="POST" action={actions.updatePassword} class="space-y-5">
              <p class="text-ink/70">
                Setting a new password for <strong>{user.email}</strong>.
              </p>
              <div>
                <label for="password" class="label">New password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" required class="field" aria-invalid={fieldErrors.password ? 'true' : undefined} />
                {fieldErrors.password ? (
                  <p class="mt-1 text-sm text-accent-600">{fieldErrors.password.join(' ')}</p>
                ) : (
                  <p class="mt-1 text-sm text-ink/60">At least 8 characters.</p>
                )}
              </div>
              <div>
                <label for="confirmPassword" class="label">Confirm new password</label>
                <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required class="field" aria-invalid={fieldErrors.confirmPassword ? 'true' : undefined} />
                {fieldErrors.confirmPassword && <p class="mt-1 text-sm text-accent-600">{fieldErrors.confirmPassword.join(' ')}</p>}
              </div>
              {formError && <Notice tone="error">{formError}</Notice>}
              <button class="btn-primary w-full py-3">Save new password</button>
            </form>
          ) : (
            <div class="space-y-5">
              <Notice tone="error">This page only works from a password reset link, and that link may have expired.</Notice>
              <a href="/forgot-password" class="btn-primary w-full py-3">Send me a new link</a>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
