---
import { actions, isInputError } from 'astro:actions';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaImage from '../components/media/MediaImage.astro';
import Notice from '../components/Notice.astro';

const result = Astro.getActionResult(actions.requestPasswordReset);
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : {};
const formError = result?.error && !isInputError(result.error) ? result.error.message : undefined;
const expired = !result && Astro.url.searchParams.get('expired');
---

<BaseLayout title="Reset your password">
  <section class="container-page grid items-stretch gap-10 py-10 lg:grid-cols-2 lg:py-16">
    <div class="hidden overflow-hidden rounded-3xl lg:block">
      <div class="relative h-full min-h-[36rem]">
        <MediaImage media="login-side" alt="Young people at a YEA event" sizes="50vw" priority />
      </div>
    </div>

    <div class="flex items-center justify-center">
      <div class="w-full max-w-md space-y-8">
        <div class="space-y-2">
          <p class="eyebrow">Account help</p>
          <h1 class="text-5xl text-brand-700 md:text-6xl">Reset your password</h1>
          <p class="text-ink/70">Enter the email you signed up with and we’ll send you a link to choose a new password.</p>
        </div>

        {
          result?.data ? (
            <div class="space-y-5">
              <Notice tone="success">
                If an account exists for <strong>{result.data.email}</strong>, a reset link is on its way. It expires in one hour.
              </Notice>
              <p class="text-sm text-ink/70">
                The email comes from <strong>no-reply@yeaimpactfoundation.top</strong>. If you can’t find it, check your spam or promotions
                folder, or <a href="/forgot-password" class="font-semibold text-brand-700 hover:underline">try again</a>.
              </p>
            </div>
          ) : (
            <form method="POST" action={actions.requestPasswordReset} class="space-y-5">
              {expired && <Notice tone="error">That reset link is invalid or has expired. Request a new one below.</Notice>}
              <div>
                <label for="email" class="label">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required class="field" aria-invalid={fieldErrors.email ? 'true' : undefined} />
                {fieldErrors.email && <p class="mt-1 text-sm text-accent-600">{fieldErrors.email.join(' ')}</p>}
              </div>
              {formError && <Notice tone="error">{formError}</Notice>}
              <button class="btn-primary w-full py-3">Send reset link</button>
            </form>
          )
        }

        <p class="text-center text-sm text-ink/70">
          Remembered it?{' '}
          <a href="/login" class="font-semibold text-brand-700 hover:underline">Back to sign in</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
