---
import { actions, isInputError } from 'astro:actions';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaImage from '../components/media/MediaImage.astro';
import Notice from '../components/Notice.astro';

const params = Astro.url.searchParams;
// Only allow same-site paths, so `?next=` can't send people to another site.
const rawNext = params.get('next') ?? '/';
const next = rawNext.startsWith('/') && !rawNext.startsWith('//') ? rawNext : '/';

const loginResult = Astro.getActionResult(actions.login);
const signupResult = Astro.getActionResult(actions.signup);
const resendResult = Astro.getActionResult(actions.resendConfirmation);
const signOutResult = Astro.getActionResult(actions.signOut);

if (signOutResult && !signOutResult.error) return Astro.redirect('/');
if (loginResult?.data || signupResult?.data?.signedIn) return Astro.redirect(next);

const user = Astro.locals.user;
const isSignUp = signupResult || resendResult ? true : loginResult ? false : params.get('mode') === 'signup';
const result = isSignUp ? signupResult : loginResult;
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : {};
const confirmFailed = !result && params.get('confirm') === 'failed';
const oauthFailed = !result && params.get('oauth') === 'failed';
const formError =
  result?.error && !isInputError(result.error)
    ? result.error.message
    : confirmFailed
      ? 'That confirmation link is invalid or has expired. Sign in below and we’ll send you a new one.'
      : oauthFailed
        ? 'Google sign-in was cancelled or didn’t complete. Please try again, or use your email instead.'
        : undefined;

// After sign-up (or a resend), show "check your inbox" instead of the form.
const pendingEmail = resendResult?.data?.email ?? (signupResult?.data && !signupResult.data.signedIn ? signupResult.data.email : undefined);
const awaitingConfirmation = Boolean(pendingEmail || resendResult);
const resendError = resendResult?.error
  ? isInputError(resendResult.error)
    ? 'Enter a valid email address.'
    : resendResult.error.message
  : undefined;

const nextQuery = next === '/' ? '' : `&next=${encodeURIComponent(next)}`;
const formAction = `${isSignUp ? actions.signup : actions.login}${nextQuery}`;
const googleAction = next === '/' ? '/auth/google' : `/auth/google?next=${encodeURIComponent(next)}`;
const switchHref = `/login?mode=${isSignUp ? 'login' : 'signup'}${nextQuery}`;
---

<BaseLayout title={isSignUp ? 'Create an account' : 'Sign in'}>
  <section class="container-page grid items-stretch gap-10 py-10 lg:grid-cols-2 lg:py-16">
    <div class="hidden overflow-hidden rounded-3xl lg:block">
      <div class="relative h-full min-h-[36rem]">
        <MediaImage media="login-side" alt="Young people at a YEA event" sizes="50vw" priority />
      </div>
    </div>

    <div class="flex items-center justify-center">
      <div class="w-full max-w-md space-y-8">
        {
          user ? (
            <div class="space-y-5">
              <h1 class="text-5xl text-brand-700">You’re signed in</h1>
              {params.get('confirmed') && <Notice tone="success">Your email is confirmed. Welcome to YEA!</Notice>}
              {params.get('password') === 'updated' && <Notice tone="success">Your password has been updated.</Notice>}
              <p class="text-ink/70">
                Signed in as <strong>{user.email}</strong>.
              </p>
              <div class="flex flex-wrap gap-3">
                <a href="/courses" class="btn-primary">Browse courses</a>
                <form method="POST" action={actions.signOut}>
                  <button class="btn-outline">Sign out</button>
                </form>
              </div>
            </div>
          ) : (
            <>
              <div class="space-y-2">
                <p class="eyebrow">{isSignUp ? 'Join YEA' : 'Welcome back'}</p>
                <h1 class="text-5xl text-brand-700 md:text-6xl">{isSignUp ? 'Create an account' : 'Sign in'}</h1>
                <p class="text-ink/70">
                  {isSignUp
                    ? 'Enrol in courses, request mentors, register for events and apply for jobs.'
                    : 'Sign in to continue where you left off.'}
                </p>
              </div>

              {awaitingConfirmation ? (
                <div class="space-y-5">
                  {resendError ? (
                    <Notice tone="error">{resendError}</Notice>
                  ) : (
                    <Notice tone="success">
                      {resendResult ? 'We’ve sent you a new confirmation link' : 'Almost there! We’ve sent a confirmation link'}
                      {pendingEmail && (
                        <>
                          {' '}to <strong>{pendingEmail}</strong>
                        </>
                      )}
                      . Open it to activate your account.
                    </Notice>
                  )}
                  <p class="text-sm text-ink/70">
                    The email comes from <strong>no-reply@yeaimpactfoundation.top</strong> and can take a minute or two. If you can’t find it,
                    check your spam or promotions folder.
                  </p>
                  <form method="POST" action={actions.resendConfirmation} class="space-y-3">
                    {pendingEmail ? (
                      <input type="hidden" name="email" value={pendingEmail} />
                    ) : (
                      <div>
                        <label for="resend-email" class="label">Email</label>
                        <input id="resend-email" name="email" type="email" autocomplete="email" required class="field" />
                      </div>
                    )}
                    <button class="btn-outline w-full py-3">Resend confirmation email</button>
                  </form>
                </div>
              ) : (
                <div class="space-y-6">
                  <form method="POST" action={googleAction}>
                    <button class="inline-flex w-full items-center justify-center gap-3 rounded-full bg-white px-6 py-3 text-sm font-semibold text-ink shadow-xs ring-1 ring-brand-900/15 transition ring-inset hover:bg-brand-50 hover:ring-brand-700/40">
                      <svg viewBox="0 0 48 48" class="size-5" aria-hidden="true">
                        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
                        <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                        <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z" />
                        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
                      </svg>
                      Continue with Google
                    </button>
                  </form>
                  <div class="flex items-center gap-4 text-xs font-semibold tracking-[0.15em] text-ink/50 uppercase">
                    <span class="h-px flex-1 bg-brand-900/10"></span>
                    or use your email
                    <span class="h-px flex-1 bg-brand-900/10"></span>
                  </div>
                  <form method="POST" action={formAction} class="space-y-5">
                    <div>
                      <label for="email" class="label">Email</label>
                      <input id="email" name="email" type="email" autocomplete="email" required class="field" aria-invalid={fieldErrors.email ? 'true' : undefined} />
                      {fieldErrors.email && <p class="mt-1 text-sm text-accent-600">{fieldErrors.email.join(' ')}</p>}
                    </div>
                    <div>
                      <div class="flex items-baseline justify-between gap-3">
                        <label for="password" class="label">Password</label>
                        {!isSignUp && (
                          <a href="/forgot-password" class="text-sm font-semibold text-brand-700 hover:underline">
                            Forgot password?
                          </a>
                        )}
                      </div>
                      <input
                        id="password"
                        name="password"
                        type="password"
                        autocomplete={isSignUp ? 'new-password' : 'current-password'}
                        minlength={isSignUp ? 8 : undefined}
                        maxlength="72"
                        required
                        class="field"
                        aria-invalid={fieldErrors.password ? 'true' : undefined}
                      />
                      {fieldErrors.password ? (
                        <p class="mt-1 text-sm text-accent-600">{fieldErrors.password.join(' ')}</p>
                      ) : (
                        isSignUp && <p class="mt-1 text-sm text-ink/60">At least 8 characters.</p>
                      )}
                    </div>
                    {formError && <Notice tone="error">{formError}</Notice>}
                    <button class="btn-primary w-full py-3">{isSignUp ? 'Create account' : 'Sign in'}</button>
                    {isSignUp && (
                      <p class="text-center text-xs text-ink/60">
                        By creating an account you agree to our{' '}
                        <a href="/terms" class="font-semibold text-brand-700 hover:underline">Terms of Service</a> and{' '}
                        <a href="/privacy" class="font-semibold text-brand-700 hover:underline">Privacy Policy</a>.
                      </p>
                    )}
                  </form>
                </div>
              )}

              <p class="text-center text-sm text-ink/70">
                {isSignUp ? 'Already have an account?' : 'Don’t have an account?'}{' '}
                <a href={switchHref} class="font-semibold text-brand-700 hover:underline">
                  {isSignUp ? 'Sign in' : 'Create one'}
                </a>
              </p>
            </>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
