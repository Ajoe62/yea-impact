---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Stamp from '../../components/Stamp.astro';
import { CONTACT_EMAIL, CONTACT_HREF } from '../../lib/site';

export const prerender = true;

const risks = [
  { title: 'Peer pressure', text: 'Wanting to fit in is normal. Real friends never push you into harm.' },
  { title: 'Stress & idleness', text: 'Drugs don’t fix pressure, boredom or joblessness. They make it worse.' },
  { title: 'Misinformation', text: 'Street names and “it’s just medicine” hide real dangers.' },
];

const myths = [
  { myth: '“One try won’t hurt.”', fact: 'Dependence can start sooner than you think.' },
  { myth: '“It helps me cope.”', fact: 'It deepens anxiety, depression and isolation.' },
  { myth: '“Cough syrup and tramadol are safe.”', fact: 'Misused, they cause addiction and overdose.' },
];

const drugs = ['Tramadol', 'Codeine cough syrup', 'Cannabis (“igbo”)', '“Colorado” / “Skushi”', 'Meth (“mkpuru mmiri”)', 'Alcohol & shisha misuse'];

// Icon paths are 24×24, stroked.
const icons = {
  pulse: 'M3 12h4l2-6 4 12 2-6h6',
  heart: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z',
  cap: 'M2 9l10-5 10 5-10 5L2 9Zm4 2v5c3 2 9 2 12 0v-5',
  scales: 'M12 4v16M7 20h10M5 8h14M5 8l-3 6a3 3 0 0 0 6 0L5 8Zm14 0-3 6a3 3 0 0 0 6 0l-3-6Z',
  eye: 'M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  down: 'M3 7l6 6 4-4 8 8m0 0v-6m0 6h-6',
  wallet: 'M3 7h18v12H3V7Zm0 0 2-3h14l2 3M12 13a1.5 1.5 0 1 0 0 .01',
  moon: 'M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z',
  check: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-4-9 3 3 5-6',
};

const columns = [
  {
    title: 'The effects',
    tone: 'text-accent-500',
    items: [
      { icon: icons.pulse, text: 'Brain damage & mental illness' },
      { icon: icons.heart, text: 'Heart, liver & lung harm, even death' },
      { icon: icons.cap, text: 'Ruined school, career & relationships' },
      { icon: icons.scales, text: 'Arrest & a criminal record' },
    ],
  },
  {
    title: 'Warning signs',
    tone: 'text-accent-500',
    items: [
      { icon: icons.eye, text: 'Sudden change in friends or behaviour' },
      { icon: icons.down, text: 'Falling grades & withdrawal' },
      { icon: icons.wallet, text: 'Unexplained need for money' },
      { icon: icons.moon, text: 'Red eyes, poor sleep or appetite' },
    ],
  },
  {
    title: 'Stay drug-free',
    tone: 'text-brand-700',
    items: [
      { icon: icons.check, text: 'Choose friends who lift you up' },
      { icon: icons.check, text: 'Say NO firmly & walk away' },
      { icon: icons.check, text: 'Talk to someone you trust' },
      { icon: icons.check, text: 'Keep busy: sports, skills & faith' },
    ],
  },
];

const roles = [
  { who: 'Young people', text: 'Say no, stay informed and speak up early.' },
  { who: 'Parents & guardians', text: 'Talk openly, listen and notice changes.' },
  { who: 'Schools & communities', text: 'Build safe spaces, skills and opportunities.' },
];
---

<BaseLayout
  title="Say no to drug abuse"
  description="YEA's drug abuse prevention campaign: the risks, myths and facts, warning signs, and where young people can get confidential support."
>
  <PageHero
    eyebrow="Drug abuse prevention campaign"
    title="Choose purpose"
    accent="over pressure"
    subtitle="Drugs promise an escape but deliver dependence. Every young person deserves a future built on clear, confident choices."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#facts" class="btn-primary">Know the facts</a>
      <a href={CONTACT_HREF} class="btn-ghost">Get confidential support</a>
    </div>
  </PageHero>

  <!-- Risks and myths -->
  <section id="facts" class="container-page grid scroll-mt-24 gap-16 py-20 lg:grid-cols-2 lg:gap-20 lg:py-24">
    <div>
      <p class="eyebrow">Understand the risk</p>
      <h2 class="mt-4 text-4xl text-brand-700 md:text-5xl">Why young people are at risk</h2>
      <ol class="mt-10 space-y-8">
        {
          risks.map((r, i) => (
            <li class="flex gap-5">
              <span class="font-display text-5xl leading-none text-accent-500">{String(i + 1).padStart(2, '0')}</span>
              <div class="space-y-1.5">
                <h3 class="text-xl text-brand-700">{r.title}</h3>
                <p class="leading-relaxed text-ink/75">{r.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div>
      <p class="eyebrow">Get it right</p>
      <h2 class="mt-4 text-4xl text-brand-700 md:text-5xl">Myth <em>vs</em> fact</h2>
      <ul class="mt-10 divide-y-2 divide-brand-100">
        {
          myths.map((m) => (
            <li class="space-y-3 py-6 first:pt-0">
              <p class="flex items-start gap-4">
                <span class="tag-red w-16 shrink-0 justify-center">Myth</span>
                <span class="text-lg font-semibold text-brand-700/80 italic">{m.myth}</span>
              </p>
              <p class="flex items-start gap-4">
                <span class="tag-navy w-16 shrink-0 justify-center">Fact</span>
                <span class="text-lg font-semibold text-ink">{m.fact}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Know the facts -->
  <section class="relative overflow-hidden bg-white py-20 lg:py-24">
    <div class="container-page relative space-y-12">
      <div class="flex flex-wrap items-center justify-between gap-8">
        <div class="max-w-3xl space-y-4">
          <p class="eyebrow">Your future is worth more</p>
          <h2 class="text-5xl text-brand-700 md:text-7xl">Say <em>no</em> to drug abuse</h2>
          <p class="pt-2 text-sm font-bold tracking-[0.18em] text-brand-700 uppercase">Drugs commonly abused by young people</p>
          <ul class="flex flex-wrap gap-3">
            {drugs.map((d) => <li class="chip">{d}</li>)}
          </ul>
        </div>
        <div class="w-44 -rotate-6 max-md:hidden">
          <Stamp ring="Drug-free youth · Drug-free youth · " label="Choose life" />
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {
          columns.map((c) => (
            <article class="rounded-2xl bg-mist p-7 md:p-8">
              <h3 class="font-display text-3xl tracking-wide text-brand-700 uppercase">{c.title}</h3>
              <ul class="mt-6 space-y-5">
                {c.items.map((item) => (
                  <li class="flex items-start gap-3.5 font-semibold text-ink">
                    <svg class:list={['mt-0.5 size-6 shrink-0', c.tone]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={item.icon} />
                    </svg>
                    {item.text}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Everyone has a role -->
  <section class="container-page py-20 lg:py-24">
    <div class="flex items-center gap-6">
      <h2 class="shrink-0 text-4xl text-brand-700 md:text-5xl">Everyone has a role</h2>
      <span class="h-0.5 flex-1 bg-brand-100" aria-hidden="true"></span>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        roles.map((r) => (
          <article class="card card-accent bg-mist p-7 ring-0">
            <h3 class="text-sm font-bold tracking-[0.14em] text-brand-700 uppercase">{r.who}</h3>
            <p class="mt-3 text-lg leading-relaxed text-ink/85">{r.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Support -->
  <section class="container-page pb-20 lg:pb-28">
    <div class="on-dark relative overflow-hidden rounded-3xl bg-brand-700 px-6 py-12 text-white md:px-14">
      <div class="slash-right opacity-80" style="width: min(30vw, 16rem)" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <div class="space-y-3">
          <p class="eyebrow eyebrow-on-dark">Need support? It’s confidential</p>
          <a href={CONTACT_HREF} class="block text-3xl font-bold break-all hover:underline md:text-5xl">{CONTACT_EMAIL}</a>
          <p class="text-white/80">Help is available. Recovery is possible.</p>
        </div>
        <a href={CONTACT_HREF} class="btn-primary shrink-0 px-8 py-4 lg:mr-40">Reach out to us</a>
      </div>
    </div>
  </section>
</BaseLayout>
