---
import BaseLayout from '../layouts/BaseLayout.astro';

// Rendered on demand (not prerendered) so detail pages can show it via Astro.rewrite('/404').
---

<BaseLayout title="Page not found">
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center gap-5 py-16 text-center">
    <p class="font-display text-7xl font-extrabold text-sun-500">404</p>
    <h1 class="text-3xl font-bold text-brand-900">We couldn’t find that page.</h1>
    <p class="max-w-md text-ink/70">It may have moved, or the link might be wrong.</p>
    <a href="/" class="btn-primary">Back to home</a>
  </section>
</BaseLayout>
