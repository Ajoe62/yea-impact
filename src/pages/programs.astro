---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';

const supabase = Astro.locals.supabase;
const { data: programs } = supabase
  ? await supabase.from('programs').select('id, slug, name, description').order('name', { ascending: true })
  : { data: null };
---

<BaseLayout title="Programs" description="YEA's core areas of impact.">
  <PageHero
    media="programs-hero"
    alt="YEA programme participants"
    eyebrow="Programs"
    title="Programs & areas of impact"
    subtitle="The core areas where we invest in Africa's young people."
  />

  <section class="container-page py-14 lg:py-20">
    {
      programs && programs.length > 0 ? (
        <ol class="grid gap-5 md:grid-cols-2">
          {programs.map((p, i) => (
            <li id={p.slug ?? undefined} class="card flex gap-5 p-6 md:p-8">
              <span class="font-display text-3xl font-extrabold text-sun-500" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="space-y-2">
                <h2 class="text-xl font-bold text-brand-900">{p.name}</h2>
                <p class="leading-relaxed text-ink/70">{p.description}</p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <EmptyState message="No programs found. Please check back later." />
      )
    }
  </section>
</BaseLayout>
